{
  "id": "matrix-element-call-recorder-plugin",
  "name": "E2EE Call Recorder",
  "version": "2.0.0",
  "description": "Record button for Element Call conferences in the Element Web room header. Loaded as an ESM module through the official Element Web Module API; all requests go to relative paths on the current origin.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/sljob/matrix-element-call-recorder",
  "type": "element-web-module",
  "main": "index.js",
  "moduleApi": {
    "package": "@element-hq/element-web-module-api",
    "versionRange": ">=1.12.0 <3.0.0",
    "integration": "extras.addRoomHeaderButtonCallback",
    "hostGlobals": ["window.React", "window.mxMatrixClientPeg"]
  },
  "compatibility": {
    "elementWeb": {
      "min": "1.12.16",
      "tested": ["1.12.22", "1.12.23"],
      "image": "vectorim/element-web",
      "moduleEntrypoint": "/docker-entrypoint.d/18-load-element-modules.sh",
      "installPath": "/modules/recorder/"
    },
    "elementCall": { "min": "0.14.0", "tested": ["0.24.0"] },
    "synapse": { "min": "1.90.0", "tested": ["1.156.0"] },
    "traefik": { "min": "3.0.0", "tested": ["3.7.7"] }
  },
  "configKey": "io.github.matrix-element-call-recorder",
  "configDefaults": {
    "apiBase": "/recording",
    "recordingsPath": "/recordings/",
    "lang": "auto",
    "showRecordingsLink": true,
    "alwaysVisible": true,
    "pollIntervalMs": 5000
  },
  "api": {
    "start":  { "method": "POST", "path": "{apiBase}/api/record/start",  "body": { "room": "!roomId:server" } },
    "stop":   { "method": "POST", "path": "{apiBase}/api/record/stop",   "body": { "room": "!roomId:server" } },
    "status": { "method": "GET",  "path": "{apiBase}/api/record/status", "query": { "room": "!roomId:server" } },
    "auth": "Authorization: Bearer <matrix access token>"
  },
  "languages": ["ru", "en"],
  "files": [
    "index.js",
    "manifest.json",
    "package.json",
    "locales/ru.json",
    "locales/en.json"
  ]
}
